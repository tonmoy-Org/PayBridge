PORT=5000
BACKEND_URL=https://paybridge-org.vercel.app
FRONTEND_URL=https://paybridge-org.vercel.app
ALLOWED_ORIGINS=https://paybridge-org.vercel.app,http://localhost:3000

MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pay_bridge?retryWrites=true&w=majority
DB_URL=mongodb://127.0.0.1:27017/pay_bridge

# bKash API Credentials
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_API_KEY=your_bkash_app_key
BKASH_SECRET_KEY=your_bkash_app_secret

# bKash API Endpoints
BKASH_GRANT_TOKEN_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout/token/grant
BKASH_CREATE_PAYMENT_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout/create
BKASH_EXECUTE_PAYMENT_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout/execute
BKASH_REFUND_TRANSACTION_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout/payment/refund

# bKash Callback URL
BKASH_CALLBACK_URL=http://localhost:5000/api/bkash/payment/callback

# SSLCommerz Payment Gateway
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCOMMERZ_LIVE_MODE=false

# SSLCommerz Callback URLs
SSLCOMMERZ_SUCCESS_URL=http://localhost:5000/api/sslcommerz/payment/success
SSLCOMMERZ_FAIL_URL=http://localhost:5000/api/sslcommerz/payment/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:5000/api/sslcommerz/payment/cancel
SSLCOMMERZ_IPN_URL=http://localhost:5000/api/sslcommerz/payment/ipn

# Stripe Payment Gateway
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_SUCCESS_URL=http://localhost:5000/api/stripe/payment/success
STRIPE_CANCEL_URL=http://localhost:5000/api/stripe/payment/cancel
